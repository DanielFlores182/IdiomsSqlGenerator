			<script name="SQL_Editor" id="ba57e900-6c18-4314-a9b2-01c41233b232" language="SQL" >
				<string><![CDATA[CREATE SCHEMA IF NOT EXISTS tbd_homework_postpage;

CREATE  TABLE tbd_homework_postpage.funcion ( 
	id_funcion           integer  NOT NULL  ,
	nombre               varchar(9999999)  NOT NULL  ,
	descripcion          varchar(9999999)  NOT NULL  ,
	activo               boolean  NOT NULL  ,
	CONSTRAINT pk_funcion PRIMARY KEY ( id_funcion )
 );

CREATE  TABLE tbd_homework_postpage.persona ( 
 );

CREATE  TABLE tbd_homework_postpage.piloto ( 
	id_piloto            integer  NOT NULL  ,
	nombre               varchar(9999999)  NOT NULL  ,
	CONSTRAINT pk_pilto PRIMARY KEY ( id_piloto )
 );

CREATE  TABLE tbd_homework_postpage.proveedor_cloud ( 
	id_proovedor         integer  NOT NULL  ,
	nombre               varchar(9999999)    ,
	CONSTRAINT pk_proveedor_cloud PRIMARY KEY ( id_proovedor )
 );

CREATE  TABLE tbd_homework_postpage.rol ( 
	id_rol               integer  NOT NULL  ,
	nombre               varchar(9999999)  NOT NULL  ,
	descripcion          varchar(9999999)  NOT NULL  ,
	activo               boolean  NOT NULL  ,
	CONSTRAINT pk_rol PRIMARY KEY ( id_rol )
 );

CREATE  TABLE tbd_homework_postpage.tipo_archivo ( 
	id_tipo_archivo      integer  NOT NULL  ,
	formato              varchar  NOT NULL  ,
	CONSTRAINT pk_tipo_archivo PRIMARY KEY ( id_tipo_archivo )
 );

CREATE  TABLE tbd_homework_postpage.tipo_publicacion ( 
	id_tipo              integer  NOT NULL  ,
	nombre               varchar(9999999)  NOT NULL  ,
	descripcion          varchar(9999999)  NOT NULL  ,
	CONSTRAINT pk_tipo_publicacion PRIMARY KEY ( id_tipo )
 );

CREATE  TABLE tbd_homework_postpage.trabajador ( 
	id_trabajador        integer  NOT NULL  ,
	nombre               varchar(9999999)  NOT NULL  ,
	id_supervisado       integer  NOT NULL  ,
	CONSTRAINT pk_reflectivo PRIMARY KEY ( id_trabajador ),
	CONSTRAINT fk_trabajador_trabajador FOREIGN KEY ( id_supervisado ) REFERENCES tbd_homework_postpage.trabajador( id_trabajador )   
 );

CREATE  TABLE tbd_homework_postpage.ui ( 
	id_ui                integer  NOT NULL  ,
	nombre               varchar(9999999)  NOT NULL  ,
	CONSTRAINT pk_ui PRIMARY KEY ( id_ui )
 );

CREATE  TABLE tbd_homework_postpage.user_n ( 
	id_contacto          integer  NOT NULL  ,
	nombre               varchar  NOT NULL  ,
	datos                varchar  NOT NULL  ,
	passwordkey          varchar  NOT NULL  ,
	CONSTRAINT pk_uresn PRIMARY KEY ( id_contacto )
 );

CREATE  TABLE tbd_homework_postpage.contacto_admin ( 
	user_n_id_contacto   integer  NOT NULL  ,
	CONSTRAINT pk_contacto_admin PRIMARY KEY ( user_n_id_contacto ),
	CONSTRAINT fk_contacto_admin_usern FOREIGN KEY ( user_n_id_contacto ) REFERENCES tbd_homework_postpage.user_n( id_contacto )   
 );

CREATE  TABLE tbd_homework_postpage.contacto_estudiante ( 
	user_n_id_contacto   integer  NOT NULL  ,
	CONSTRAINT pk_contacto_estudainte PRIMARY KEY ( user_n_id_contacto ),
	CONSTRAINT fk_contacto_estudainte_usern FOREIGN KEY ( user_n_id_contacto ) REFERENCES tbd_homework_postpage.user_n( id_contacto )   
 );

